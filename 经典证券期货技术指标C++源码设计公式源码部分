double test::HighestFC(string period, string inst, string Pricetype, int num)
{
	if (num <= 0)return 0;
	double d = 0;
	int n = 0;
	bool inited = false; //标记是否已用第一个有效值初始化d
	RsqBar(period, inst);//调用数据
	if (mapK[period][inst].empty())return 0;// 调用失败返回0
	map<string, TKVALUE>::reverse_iterator it;
	for (it = mapK[period][inst].rbegin(); it != mapK[period][inst].rend(); ++it)
	{
		double v = 0;
		if (Pricetype == "close")v = it->second.dClose;
		else if (Pricetype == "high")v = it->second.dHigh;
		else if (Pricetype == "low")v = it->second.dLow;
		else if (Pricetype == "open")v = it->second.dOpen;
		else v = it->second.dClose;
		if (!inited) { d = v; inited = true; } //第一次进入用当前值初始化,不依赖硬编码常数
		else { d = max2(d, v); }

		n++;
		if (n >= num)break; //当循环次数n大于等于num时跳出循环
	}
	if (!inited)return 0;
	return d;
}
