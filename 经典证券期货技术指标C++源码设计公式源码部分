	closev = SeriesClose();

	vector<double>closref1, h_l, h_c, l_c;
	closref1 = SeriesForwardref(closev, 1);
	h_l = SeriesMinus(highv, lowv);
	h_c = SeriesMinus(highv, closref1);
	h_c = SeriesAbs(h_c);
	l_c = SeriesMinus(lowv, closref1);
	l_c = SeriesAbs(l_c);

	vector<double>tr0, tr1;
	for (size_t i = 0; i < h_l.size(); i++)
	{
		tr0.push_back(max3(h_l[i], h_c[i], l_c[i]));
	}
	tr1 = SeriesSummation(tr0, num);

	vector<double>HD, LD, highref1, lowref1;

	highref1 = SeriesForwardref(highv, 1);
	lowref1 = SeriesForwardref(lowv, 1);

	HD = SeriesMinus(highv, highref1);
	LD = SeriesMinus(lowref1, lowv);

	vector<double>DMP, DMM;
	for (size_t i = 0; i < HD.size(); i++)
	{
		DMP.push_back(iff(HD[i] > 0 && HD[i] > LD[i], HD[i], 0));
		DMM.push_back(iff(LD[i] > 0 && LD[i] > HD[i], LD[i], 0));
	}

	vector<double>dmp1, dmm1;
	dmp1 = SeriesSummation(DMP, num);
	dmm1 = SeriesSummation(DMM, num);

	vector<double>pdi, mdi, pdi100, mdi100;
	pdi = SeriesDivide(dmp1, tr1);
	mdi = SeriesDivide(dmm1, tr1);
	mdi100 = SeriestimesN(mdi, 100);
	reverse(mdi100.begin(), mdi100.end());
	return mdi100;
}
//抛物线转向指标(SAR)默认参数，af = 0.02,max_af = 0.2
//---------------------------------------------------------------------------（版本一）-----------------------------------------------------------------+
vector<double> test::SAR(vector<double> highs, vector<double> lows, double initial_af, double max_af)
{
	reverse(highs.begin(), highs.end());//恢复计算变量为正序以方便下面的计算
	reverse(lows.begin(), lows.end());//恢复计算变量为正序以方便下面的计算
   // 初始化输出容器
	vector<double> sar_values(highs.size());
	if (highs.empty()) return sar_values;

	// 初始参数设置
	bool is_uptrend = true;       // 初始趋势方向
	double af = initial_af;          // 当前加速因子
	double ep = highs.front();    // 极值点(EP)
	sar_values[0] = lows.front(); // 初始SAR值

	for (size_t i = 1; i < highs.size(); ++i) {
		// 1. 计算临时SAR值
		double prev_sar = sar_values[i - 1];
		double current_sar = prev_sar + af * (ep - prev_sar);

		// 2. 趋势反转检测
		if ((is_uptrend && lows[i] < current_sar) ||
			(!is_uptrend && highs[i] > current_sar)) {
			is_uptrend = !is_uptrend;       // 反转趋势
			current_sar = ep;               // SAR重置为前极值
			ep = is_uptrend ? highs[i] : lows[i]; // 更新EP
			af = initial_af;                   // 重置加速因子
		}
		// 3. 更新极值和加速因子(未反转时)
		else if ((is_uptrend && highs[i] > ep) ||
			(!is_uptrend && lows[i] < ep)) {
			ep = is_uptrend ? highs[i] : lows[i];
			af = min2(af + initial_af, max_af);
		}

		// 4. 应用极值保护规则
		if (is_uptrend) {
			if (i >= 2) current_sar = min2(current_sar, lows[i - 1]);
			current_sar = min2(current_sar, lows[i]);
		}
		else {
			if (i >= 2) current_sar = max2(current_sar, highs[i - 1]);
			current_sar = max2(current_sar, highs[i]);
		}

		sar_values[i] = current_sar;
	}
	reverse(sar_values.begin(), sar_values.end());//转为逆序，以与MC规范统一
	return sar_values;
}
