//| CCI 商品通道指数                                                                                                |
//|‌ 由唐纳德·兰伯特于1980年提出，主要用来判断价格是否超出常态波动范围，‌±100是关键分界线‌。PC数组逆序，输出也是逆序 |                                                                                            |
//+-----------------------------------------------------------------------------------------------------------------+
vector<double> test::CCI(vector<double> pc, int num)
{
	vector<double> result;

	if (num <= 0)
		return result;

	int size = pc.size();

	if (size < num)
		return result;

	result.resize(size, 0);
	for (size_t i = 0; i <= size - num; i++)
	{
		//==================================================
		// 1. 计算N周期平均典型价
		//==================================================
		double average = 0;

		for (size_t j = 0; j < num; j++)
		{
			average += pc[i + j];
		}

		average /= num;


		//==================================================
		// 2. 计算N周期平均偏差 MD
		//==================================================
		double meanDeviation = 0;

		for (size_t j = 0; j < num; j++)
		{
			meanDeviation += fabs(pc[i + j] - average);
		}

		meanDeviation /= num;


		//==================================================
		// 3. CCI
		//==================================================
		if (meanDeviation != 0)
		{
			result[i] =
				(pc[i] - average) /
				(0.015 * meanDeviation);
		}
		else
		{
			result[i] = 0;
		}
	}
	return result;
}
