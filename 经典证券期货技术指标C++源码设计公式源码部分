//|返回整个序列的 LinearRegValue 数组                               |
//|price: 输入序列(close等)                                         |
//|length: 回归周期                                                 |
//|返回: 与 price 等长的序列, 前 length-1 个点设为 NAN              |                                                    
//+-----------------------------------------------------------------+
	//LinearRegression线性回归【逆序数组格式】
vector<double> test::LinearRegression(vector<double> pc, int num)
{
	reverse(pc.begin(), pc.end());   //将数组顺序转为正常顺序
	int size = pc.size();            //获得数组大小
	vector<double>result(size, NAN); //初始化为 NAN

	if (num <= 1 || size < num)
	{
		return result; //数据不够，返回 NAN
	}

	for (int end = num - 1; end < size; ++end)
	{
		int start = end - num + 1;

		// 回归计算
		double sumX = 0.0, sumY = 0.0, sumXY = 0.0, sumX2 = 0.0;
		for (int i = 0; i < num; i++) {
			double x = i;
			double y = pc[start + i];
			sumX += x;
			sumY += y;
			sumXY += x * y;
			sumX2 += x * x;
		}

		double denominator = num * sumX2 - sumX * sumX;
		if (denominator == 0.0) {
			result[end] = NAN;
			continue;
		}

		double slope = (num * sumXY - sumX * sumY) / denominator;
		double intercept = (sumY - slope * sumX) / num;

		// 回归线在最后一个点 (对应 end) 的值
		double xVal = num - 1;
		result[end] = intercept + slope * xVal;
	}
	reverse(result.begin(), result.end());//调转数组顺序以与行业规范统一
	return result;
}
