//=========================================================
// CrossesAbove
// 上穿事件（pc1 上穿 pc2）
// bar = 起始判断位置（0=最新Bar）
//=========================================================
bool test::CrossesAbove(vector<double> pc1, vector<double> pc2, int bar)
{
	int len1 = (int)pc1.size();
	int len2 = (int)pc2.size();

	int len = len1 < len2 ? len1 : len2;

	if (len <= 1)
		return false;

	if (bar < 0)
		return false;

	if (bar + 1 >= len)
		return false;

	if (pc1[bar] > pc2[bar] && pc1[bar + 1] <= pc2[bar + 1])
		return true;

	return false;
}
