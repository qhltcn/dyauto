//数组型Truerange计算公式【参数数组为正序,返回数组也为正序】
vector<double> test::SeriesTruerange()
{
	double dPreClose = 0;
	double sumatr = 0;
	vector<double>vAtr;
	RsqBar(sPeriod, sInst);
	map<string, TKVALUE >::iterator it;
	for (it = mapK[sPeriod][sInst].begin(); it != mapK[sPeriod][sInst].end(); ++it)
	{
		if (dPreClose != 0) //后续bar的计算
		{
			double d = it->second.dHigh - it->second.dLow;
			double dHC = abs(it->second.dHigh - dPreClose);
			double dLC = abs(it->second.dLow - dPreClose);
			if (d < dHC)d = dHC;
			if (d < dLC)d = dLC;
			vAtr.push_back(d);
		}
		dPreClose = it->second.dClose; //第一次运行先将收盘价赋值给dpreclose,方便后同的计算
	}
	return vAtr;
}
//数组型Truerange的N周期平均计算公式【参数数组为正序,返回数组也为正序】
vector<double> test::SeriesAvgTruerange(int num)
{
	double dPreClose = 0;//上根bar的收盘价
	vector<double>vAtr, avgatr; //tr变量及平均atr变量声明
	RsqBar(sPeriod, sInst); //调用数据
	map<string, TKVALUE >::iterator it;//C++中很重要的一个使用场景迭代
	for (it = mapK[sPeriod][sInst].begin(); it != mapK[sPeriod][sInst].end(); ++it) //在bar数据中进行遍历
	{
		if (dPreClose != 0) //，先判断是不是第一个bar,因为涉及到上一个bar的收盘价元素,不是第一个bar就正常计算
		{
			double d = it->second.dHigh - it->second.dLow; //当根bar的最高价high - 当根bar的最低价
			double dHC = abs(it->second.dHigh - dPreClose);//当根bar的最高价high - 上根bar的收盘价(为了防止出现负值，取绝对值) 
			double dLC = abs(it->second.dLow - dPreClose); //当根bar的最低低价 - 上根bar的收盘价(为了防止出现负值，取绝对值) 
			if (d < dHC)d = dHC;//三个值比大小，先取两人个比。用一个中间变量d赋值d dHC是的大值，
			if (d < dLC)d = dLC;//三个值比大小，再用上面的d值与dLC比大小，大的值继续赋给d
			//这里还有一个更简单更直接的逻辑方法：max3(d,dHC,dLC);这样可以一步求出三者最大值
			vAtr.push_back(d); //将比较后的最大值存入变量vatr中
		}
		dPreClose = it->second.dClose; //第一次运行先将收盘价赋值给dpreclose,方便后同的计算,所以第一轮循环是不涉及计算的
	}

	for (size_t i = 0; i < vAtr.size(); i++)//对上面的tr进行数组处理
	{
		if (i < num) //数量小于周期时用0代替
		{
			avgatr.push_back((int)0);//平均atr以0替代
		}
		else //bar数目大于要求的周期后正常计算
		{
			double sumatr = 0; //中间加总和的变量
			for (size_t j = 0; j < num; j++) //从标号为i的变量开始
			{
				sumatr += vAtr[i - j]; //向左加num个tr值
			}
			avgatr.push_back(sumatr / num);//加总的tr值和除以num周期就是平均atr了。存入avgatr数组变量就可以了
		}
	}
	return avgatr; //将刚才的值返回函数就可以了
}
//第八部分 数组中级运算函数(极值,均值,方差)【参数数组为正序,返回数组也为正序】

//第九部分 指标函数计算(开始)【参数数组为正序,返回数组也为正序】
//RSI（相对强弱指数）设计【参数数组为正序,返回数组也为正序】
vector<double> test::SeriesRSI(vector<double> pc, int num)
{
	vector<double>cp1, p1_p2, u_p, d_p;//容器变量存入相对应数据元素

	//采集close数据元素
	cp1 = pc; //close

	//计算close[1]
	vector <double>c1;
	c1 = SeriesForwardref(cp1, 1);//LC

	//计算close - close[1]
	p1_p2 = SeriesMinus(cp1, c1); //CLOSE-LC

	//MAX(CLOSE - LC, 0)
	for (size_t i = 0; i < cp1.size(); i++)
	{
		u_p.push_back(max2(p1_p2[i], 0));//MAX(CLOSE-LC,0)
		d_p.push_back(iff(p1_p2[i] < 0, abs(p1_p2[i]), 0));
		//d_p.push_back(abs(p1_p2[i]));//ABS(CLOSE-LC)
	}
	//取平均,默认是14周期
	vector<double>sum_u, sum_d;
	////wilder
	//sum_u = SeriesWilderSmoothingMethod(u_p, 14);
	//sum_d = SeriesWilderSmoothingMethod(d_p, 14);
	sum_u = SeriesSMA(u_p, num, 1);
	sum_d = SeriesSMA(d_p, num, 1);

	//计算RS
	vector<double>RS;
	RS = SeriesDivide(sum_u, sum_d);

	//计算RSI
	vector<double>rs1, rs2, rs3, RSI;
	rs1 = SeriesPlusN(RS, 1);//RS+1
	rs2 = SeriesNDivide(100, rs1);//100/(RS+1)
	RSI = SeriesNMinus(100, rs2);//100 - 100/(RS+1)
	//RSI = SeriestimesN(RS, 100);//RSI = SMA(MAX(CLOSE-LC,0),N1,1)/SMA(ABS(CLOSE-LC),14,1)*100;

	return RSI;
}
