vector<double> test::Adx(int num1, int num2)
{
	vector<double>highv, lowv, closev;
	highv = SeriesHigh();
	lowv = SeriesLow();
	closev = SeriesClose();

	vector<double>closref1, h_l, h_c, l_c;
	closref1 = SeriesForwardref(closev, 1);
	h_l = SeriesMinus(highv, lowv);
	h_c = SeriesMinus(highv, closref1);
	h_c = SeriesAbs(h_c);
	l_c = SeriesMinus(lowv, closref1);
	l_c = SeriesAbs(l_c);

	vector<double>tr0, tr1;
	for (size_t i = 0; i < h_l.size(); i++)
	{
		tr0.push_back(max3(h_l[i], h_c[i], l_c[i]));
	}
	tr1 = SeriesSummation(tr0, num1);

	vector<double>HD, LD, highref1, lowref1;

	highref1 = SeriesForwardref(highv, 1);
	lowref1 = SeriesForwardref(lowv, 1);

	HD = SeriesMinus(highv, highref1);
	LD = SeriesMinus(lowref1, lowv);

	vector<double>DMP, DMM;
	for (size_t i = 0; i < HD.size(); i++)
	{
		DMP.push_back(iff(HD[i] > 0 && HD[i] > LD[i], HD[i], 0));
		DMM.push_back(iff(LD[i] > 0 && LD[i] > HD[i], LD[i], 0));
	}

	vector<double>dmp1, dmm1;
	dmp1 = SeriesSummation(DMP, num1);
	dmm1 = SeriesSummation(DMM, num1);

	vector<double>pdi, mdi, pdi100, mdi100;
	pdi = SeriesDivide(dmp1, tr1);
	mdi = SeriesDivide(dmm1, tr1);
	pdi100 = SeriestimesN(pdi, 100);
	mdi100 = SeriestimesN(mdi, 100);

	vector<double>mdi_pdi, mdi_pdiabs, mdippdi, dx, dx1;
	mdi_pdi = SeriesMinus(mdi100, pdi100);
	mdi_pdiabs = SeriesAbs(mdi_pdi);
	mdippdi = SeriesPlus(mdi100, pdi100);
	dx = SeriesDivide(mdi_pdiabs, mdippdi);
	dx1 = SeriestimesN(dx, 100);

	vector<double>adxv;
	adxv = SeriesAverage(dx1, num2);
	reverse(adxv.begin(), adxv.end());
	return adxv;
}
