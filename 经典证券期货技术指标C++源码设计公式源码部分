//KDJ指标中的J值数组变量(正序数组)J = 3*K - 2*D
vector<double> test::SeriesKDJ_jvalue()
{
	vector<double>highs, lows, closes, highesthigh, lowestlow; //声明四个变量容器，分别存储当根bar的最高价、最低价及period周期的最高价和最低价
	int period = 9;//声明整数变量KDJ的周期9
	vector<double> K, D, J;//声明KDJ的三个容器变量
	highs = SeriesHigh();//调用正序最高价
	lows = SeriesLow();//调用正序最低价
	closes = SeriesClose();//调用正序收盘价
	highesthigh = SeriesHighest(highs, period);//调用period（9）周期内high的最高价highest(9)
	lowestlow = SeriesLowest(lows, period);//调用period（9）周期内low的最低价lowest(9)
	vector<double>c_l, h_l, rsv0, rsv;//声明四个中间变量
	c_l = SeriesMinus(closes, lowestlow);//close - lowest(9)
	h_l = SeriesMinus(highesthigh, lowestlow);//highest(9)-lowest(9)
	rsv0 = SeriesDivide(c_l, h_l);//(close-lowest(9))/(highest(9)-lowest(9))
	rsv = SeriestimesN(rsv0, 100);//声明未成熟随机值RSV0*100
	K = SeriesSMA(rsv, 3, 1);//K值(此时K为正序数组，尚未reverse)
	D = SeriesSMA(K, 3, 1);//D值(此时D为正序数组，尚未reverse)

	vector<double>K3, D2;//声明J值计算的中间变量
	K3 = SeriestimesN(K, 3);//3*K
	D2 = SeriestimesN(D, 2);//2*D
	J = SeriesMinus(K3, D2);//J = 3*K - 2*D
	return J;
}
