//指数平滑移动平均函数(SMA,sma(x,N,M),即x变量的N周期平均，最新值权重为M，即SMAt = SMAt-1 * (N-M)/N + x*M/N )返回数组形式
vector<double> test::SMA(vector<double> pc, int num, int num2)
{
	reverse(pc.begin(), pc.end());
	vector<double> smav;
	if (pc.empty()) return smav;
	smav.push_back(pc[0]);
	for (size_t i = 1; i < pc.size(); i++)
	{
		double d =
			(smav[i - 1] * (num - num2) + pc[i] * num2) / (double)num;
		smav.push_back(d);
	}
	reverse(smav.begin(), smav.end());
	return smav;
}
//加权移动平均线（Weighted Moving Average，WMA）的计算方法公式返数组
vector<double> test::WMA(vector<double> pc, int num)
{
	reverse(pc.begin(), pc.end());
	vector<double> wma;
	if (num <= 0)return wma;
	int totalWeight = num * (num + 1) / 2;
	for (size_t i = 0; i < pc.size(); i++)
	{
		if ((int)i + 1 < num)
		{
			wma.push_back(0);
		}
		else
		{
			double sum = 0;
			for (int j = 0; j < num; j++)
			{
				sum += pc[i - j] * (num - j);
			}
			wma.push_back(sum / totalWeight);
		}
	}
	reverse(wma.begin(), wma.end());
	return wma;
}
//CR能量指标
//+-------------------------------------------------------------------------------------------+
//| MID: = (HIGH + LOW + CLOSE) / 3;                                                          |
//| CR:SUM(MAX(0, HIGH - REF(MID, 1)), N) / SUM(MAX(0, REF(MID, 1) - LOW), N) * 100;          |
//+-------------------------------------------------------------------------------------------+
vector<double> test::CR(int num)
{
	//参数设置
	int period = num;

	//变量初始化
	vector<double>mid, high_mid, midref, mid_low, max_high_mid, max_mid_low, sum_high_mid, sum_mid_low, cr;
	vector<double>ihigh, ilow, iclose;

	mid.clear();
	high_mid.clear();
	midref.clear();
	mid_low.clear();
	max_high_mid.clear();
	max_mid_low.clear();
	sum_high_mid.clear();
	sum_mid_low.clear();
	cr.clear();

	ihigh.clear();
	ilow.clear();
	iclose.clear();

	ihigh = SeriesHigh();
	ilow = SeriesLow();
	iclose = SeriesClose();

	mid = (ihigh + ilow + iclose) / 3;  //MID
	midref = SeriesForwardref(mid, 1);//REF(MID,1)
	high_mid = ihigh - midref;        //HIGH-REF(MID,1)
	mid_low = midref - ilow;          //REF(MID,1)-LOW

	for (size_t i = 0; i < mid.size(); i++)
	{
		max_high_mid.push_back(max2(0, high_mid[i]));//MAX(0,HIGH-REF(MID,1))
		max_mid_low.push_back(max2(0, mid_low[i]));  //MAX(0,REF(MID,1)-LOW)
	}
	sum_high_mid = SeriesSummation(max_high_mid, period);//SUM(MAX(0,HIGH-REF(MID,1)),N)
	sum_mid_low = SeriesSummation(max_mid_low, period);  //SUM(MAX(0,REF(MID,1)-LOW),N)
	cr = sum_high_mid / sum_mid_low;
	cr = cr * 100;

	reverse(cr.begin(), cr.end());//调转数组顺序以与行业规范统一

	return cr;
}
