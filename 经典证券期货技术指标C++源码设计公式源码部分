//ATR,averagetruerange计算公式开始
double test::AvgtruerangeFC(string period, string inst, int num)
{
	if (num <= 0)return 0;
	double dPreClose = 0;
	double sumatr = 0;
	vector<double>vAtr;
	RsqBar(period, inst);//调用数据
	if (mapK[period][inst].empty())return 0;// 调用失败返回0
	map<string, TKVALUE >::iterator it;
	for (it = mapK[period][inst].begin(); it != mapK[period][inst].end(); ++it)
	{
		if (dPreClose != 0)
		{
			double d = it->second.dHigh - it->second.dLow;
			double dHC = abs(it->second.dHigh - dPreClose);
			double dLC = abs(it->second.dLow - dPreClose);
			if (d < dHC)d = dHC;
			if (d < dLC)d = dLC;
			vAtr.push_back(d);
		}
		dPreClose = it->second.dClose;
	}
	if ((int)vAtr.size() < num) return 0; //用真实参与计算的TR数组长度做检查

	for (int i = 1; i <= num; i++)
	{
		sumatr += vAtr[vAtr.size() - i];
	}
	return  sumatr / num;
}

//布林带(bollingerbands)开始
double test::BollingerbandsFC(string period, string inst, int num, int numDevs)
{
	if (num <= 0 || numDevs < 0)return 0;
	double avg1 = AverageFC(period, inst, "close", num);//中间均线
	int n = 0;
	double sumdev = 0;
	double madev = 0;
	if ((int)mapK[period][inst].size() < num) return 0;
	RsqBar(period, inst);//调用数据
	if (mapK[period][inst].empty())return 0;// 调用失败返回0
	map<string, TKVALUE>::reverse_iterator it;
	for (it = mapK[period][inst].rbegin(); it != mapK[period][inst].rend(); ++it)
	{
		sumdev += pow(it->second.dClose - avg1, 2);
		n++;
		if (n >= num)break;
	}
	madev = sqrt(sumdev / num);
	return avg1 + numDevs * madev;
}

//方差计算公式开始
double test::VarianceFC(string period, string inst, int num)
{
	if (num <= 0)return 0;
	double avg1 = AverageFC(period, inst, "close", num);//中间均线
	int n = 0;
	double sumdev = 0;
	double madev = 0;
	if (mapK[period][inst].size() < num) return 0;
	RsqBar(period, inst);//调用数据
	if (mapK[period][inst].empty())return 0;// 调用失败返回0
	map<string, TKVALUE>::reverse_iterator it;
	for (it = mapK[period][inst].rbegin(); it != mapK[period][inst].rend(); ++it)
	{
		sumdev += pow(it->second.dClose - avg1, 2); //偏离平方加总
		n++;
		if (n >= num)break;
	}
	if (n == 0)return 0;
	return sumdev / n;
}

