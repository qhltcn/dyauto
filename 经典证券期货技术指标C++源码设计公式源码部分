//=========================================================
double test::ValueWhen(vector<double> cond, vector<double> value, int occurrence)
{
	int len;

	int count = 0;

	if (occurrence <= 0)
		return 0;

	len = (int)cond.size();

	if (len == 0)
		return 0;

	if ((int)value.size() < len)
		len = (int)value.size();

	for (int i = 0; i < len; i++)
	{
		if (cond[i] == 1)
		{
			count++;

			if (count == occurrence)
				return value[i];
		}
	}

	return 0;
}
