// SeriesMaxIndex(A, N)：每个位置 i，返回最近 N 根中最大值位置（或距离）
vector<double> test::SeriesMaxIndex(vector<double> a, int n)
{
	vector<double> out;
	if (a.empty() || n <= 0) return out;

	for (size_t i = 0; i < a.size(); i++)
	{
		int start = (i < (size_t)n - 1) ? 0 : i - n + 1;

		double maxv = a[start];
		int idx = start;

		for (size_t j = start; j <= i; j++)
		{
			if (a[j] > maxv)
			{
				maxv = a[j];
				idx = j;
			}
		}

		out.push_back((double)(i - idx)); // 距离当前K线的bar数
	}

	return out;
}
// SeriesMinIndex(A, N)：每个位置 i，返回最近 N 根中最小值位置（或距离）
vector<double> test::SeriesMinIndex(vector<double> a, int n)
{
	vector<double> out;
	if (a.empty() || n <= 0) return out;

	for (size_t i = 0; i < a.size(); i++)
	{
		int start = (i < (size_t)n - 1) ? 0 : i - n + 1;

		double minv = a[start];
		int idx = start;

		for (size_t j = start; j <= i; j++)
		{
			if (a[j] < minv)
			{
				minv = a[j];
				idx = j;
			}
		}

		out.push_back((double)(i - idx));
	}

	return out;
}
