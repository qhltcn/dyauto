//=========================================================
// CrossAbove 上穿条件序列
// 当前Bar：a>b
// 上一Bar：a<=b
//=========================================================
vector<double> test::CrossAbove(vector<double> a, vector<double> b)
{
	int n = min(a.size(), b.size());
	vector<double> result(n, 0.0);

	if (n < 2)
		return result;

	for (size_t i = 0; i < n - 1; i++)
	{
		if (a[i] > b[i] &&
			a[i + 1] <= b[i + 1])
		{
			result[i] = 1.0;
		}
	}

	return result;
}
//=========================================================
// CrossBelow 下穿条件序列
// 当前Bar：a<b
// 上一Bar：a>=b
//=========================================================
vector<double> test::CrossBelow(vector<double> a, vector<double> b)
{
	int n = min(a.size(), b.size());
	vector<double> result(n, 0.0);

	if (n < 2)
		return result;

	for (size_t i = 0; i < n - 1; i++)
	{
		if (a[i] < b[i] &&
			a[i + 1] >= b[i + 1])
		{
			result[i] = 1.0;
		}
	}

	return result;
}
