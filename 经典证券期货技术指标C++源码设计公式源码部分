//数组前NUM项元素加总计算【参数数组为正序,返回数组也为正序】
vector<double> test::SeriesSummation(vector<double> pc, int num)
{
	vector<double> sumvector;
	if (num <= 0)
	{
		Print("Error : num <= 0.");
		return sumvector;
	}
	for (size_t i = 0; i < pc.size(); i++)
	{
		double sum = 0;
		if ((int)i + 1 < num)
		{
			for (size_t j = 0; j <= i; j++)
			{
				sum += pc[i - j];
			}
		}
		else
		{
			for (int j = 0; j < num; j++)
			{
				sum += pc[i - j];
			}
		}
		sumvector.push_back(sum);
	}
	return sumvector;
}
