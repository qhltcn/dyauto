// iff功能函数开始
double test::iff(bool cond1, int num, int ref)
{
	double d = 0;
	if (cond1)
	{
		d = num;
	}
	else
	{
		d = ref;
	}
	return d;
}
//max2(a,b)比较a,b两个数字
double test::max2(double a, double b)
{
	double c = 0;
	if (a >= b)
	{
		c = a;
	}
	else
	{
		c = b;
	}
	return c;
}
//max3(a,b)比较a,b,c三个数字
double test::max3(double a, double b, double c)
{
	double d = (a >= b) ? a : b; //a,b中较大值
	if (d < c) d = c;            //再与c比较
	return d;
}
//min2(a,b)比较两个数字大小
double test::min2(double a, double b)
{
	double c = 0;
	if (a >= b)
	{
		c = b;
	}
	else
	{
		c = a;
	}
	return c;
}
//min3(a,b,c)比较三个数字大小
double test::min3(double a, double b, double c)
{
	double d = (a >= b) ? b : a; //a,b中较小值
	if (d > c) d = c;            //再与c比较
	return d;
}
string test::TrimCtpField(const char* field, size_t maxLen) {
	std::string s(field, strnlen(field, maxLen));

	size_t start = s.find_first_not_of(' ');
	if (start == std::string::npos) return "";
	size_t end = s.find_last_not_of(' ');
	return s.substr(start, end - start + 1);
}
