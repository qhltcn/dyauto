//第三类函数(常用到的bar数据元素计算函数,数值型，适合直接做逻辑判断用)
double test::SummationFC(string period, string inst, string Pricetype, int num)
{
	if (num <= 0)return 0;
	double sum = 0;//声明一个临时存储和的变量
	int n = 0;//声明一个统计循环次数的临时变量
	RsqBar(period, inst);//调用数据
	if (mapK[period][inst].empty())return 0;// 调用失败返回0
	map<string, TKVALUE>::reverse_iterator it;
	for (it = mapK[period][inst].rbegin(); it != mapK[period][inst].rend(); ++it)
	{
		if (Pricetype == "close")sum = sum + it->second.dClose;//收盘价加总
		else if (Pricetype == "high")sum = sum + it->second.dHigh;//收盘价加总
		else if (Pricetype == "low")sum = sum + it->second.dLow;//收盘价加总
		else if (Pricetype == "open")sum = sum + it->second.dOpen;//收盘价加总
		n++;
		if (n >= num)break; //当循环次数n大于等于num时跳出循环(如果bar的数目小时num周期,就按有多少bar就计算多少bar的)
	}
	return sum;
}
//均线average计算公式开始
double test::AverageFC(string period, string inst, string Pricetype, int num)
{
	if (num <= 0)return 0;
	double d = 0;
	int n = 0;
	RsqBar(period, inst);//调用数据
	if (mapK[period][inst].empty())return 0;// 调用失败返回0
	map<string, TKVALUE>::reverse_iterator it;
	for (it = mapK[period][inst].rbegin(); it != mapK[period][inst].rend(); ++it)
	{
		if (Pricetype == "close")d += it->second.dClose;
		else if (Pricetype == "high")d += it->second.dHigh;
		else if (Pricetype == "low")d += it->second.dLow;
		else if (Pricetype == "open")d += it->second.dOpen;
		else d += it->second.dClose;
		n++;
		if (n >= num)break;
	}
	if (n == 0)return 0;
	return d / n;
}
