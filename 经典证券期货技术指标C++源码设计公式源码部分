	for (size_t i = 0; i < pc.size(); i++)
	{
		if (i < num)// 当数组数量不足时用pc[i代替]
		{
			newrms.push_back(pc[i]);
		}
		else        //正常情况下计算
		{
			double sum = 0;
			for (size_t j = 0; j < num; j++)
			{
				sum = sum + pc[i - j] * pc[i - j];
			}
			rms = sqrt(sum / num);
			newrms.push_back(rms);
		}
	}
	return newrms;
}
//返回SeriesSuperSmoother(正序数组)
vector<double> test::SeriesSuperSmoother(vector<double> pc, int num)
{

	double a1, b1, c1, c2, c3;
	vector<double>newsupers;
	a1 = exp(-1.414 * 3.15159 / num);
	b1 = 2 * a1 * cos(1.414 * 180 / num);
	c2 = b1;
	c3 = -a1 * a1;
	c1 = 1 - c2 - c3;
	for (size_t i = 0; i < pc.size(); i++)
	{
		if (i < num)
		{
			newsupers.push_back((double)0);//当pc数据元素少于num时，newsupers元素用0价格代替
		}
		else
		{
			double d = c1 * (pc[i] + pc[i - 1]) / 2 + c2 * newsupers[i - 1] + c3 * newsupers[i - 2];//supersmoother计算公式
			newsupers.push_back(d);
		}
	}
	return newsupers;
}
//返回Highpass
vector<double> test::SeriesHighpass(vector<double> pc, int num) //正序数组
{
	double a1, b1, c1, c2, c3;
	vector<double>newhipass;
	a1 = exp(-1.414 * 3.15159 / num);
	b1 = 2 * a1 * cos(1.414 * 180 / num);
	c2 = b1;
	c3 = -a1 * a1;
	c1 = (1 + c2 - c3) / 4;
	for (size_t i = 0; i < pc.size(); i++)
	{
		if (i < num)
		{
			newhipass.push_back((double)0);//当pc数据元素少于num时，newsupers元素用0价格代替
		}
		else
		{
			double d = c1 * (pc[i] - 2 * pc[i - 1] + pc[i - 2]) + c2 * newhipass[i - 1] + c3 * newhipass[i - 2];//newhipass计算公式
			newhipass.push_back(d);
		}
	}
	return newhipass;
}
// OBV指标：能量潮,内部用正序数组计算(SeriesClose/SeriesVolume)，最终返回正序数组([0]为最老)
vector<double>test::SeriesOBV()
{
	vector<double> closePrice = SeriesClose();    // 正序，[0]最老
	vector<double> vol = SeriesVolume();          // 正序，[0]最老
	// 数据检查
	if (closePrice.size() != vol.size()) { Print("  收盘价与成交量数据没有对齐！"); return vector<double>(); }

	vector<double> obvSeries(closePrice.size(), 0.0); // 正序中间结果

	for (size_t i = 1; i < closePrice.size(); i++)
	{
		double diff = closePrice[i] - closePrice[(double)i - 1];

		if (diff > 0)
			obvSeries[i] = obvSeries[i - 1] + vol[i];
		else if (diff < 0)
			obvSeries[i] = obvSeries[i - 1] - vol[i];
		else
			obvSeries[i] = obvSeries[i - 1];
	}
	return obvSeries;
}
