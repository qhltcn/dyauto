//返回均方根(Root Mean Square,RMS)(数值型)
double test::RmsFC(vector<double> pc, int num)
{
	if (num <= 0)return 0;
	if (num > (int)pc.size())return 0;
	double	Sum = 0;
	double  RMS = 0;

	for (size_t i = 0; i < num; i++)
	{
		Sum = Sum + pc[i] * pc[i];
	}
	if (Sum != 0) RMS = sqrt(Sum / num);
	return RMS;
}
//线性回归预测值(数值型)
//+----------------------------------------------------------------+
//|Price：价格序列 (如 Close)                                      |
//|Length：回归计算的周期数                                        |
//|Offset：要取的点（通常 0 表示当前 bar，1 表示前一个 bar，等等） |
//|LinearRegValue(Price, Length, Offset)                           |
//+----------------------------------------------------------------+
double test::LinearRegressionFC(vector<double> pc, int num, int ref)
{
	if (num <= 1)return 0;
	if (ref < 0)return 0;
	reverse(pc.begin(), pc.end());   //将数组顺序转为正常顺序
	int size = pc.size();
	if (size < num + ref) {
		Print("数据长度不足");
		return 0;
	}

	// 回归区间： [start, end]
	int end = size - 1 - ref;
	int start = end - num + 1;

	// X 序列：0,1,2,...,length-1
	double sumX = 0.0, sumY = 0.0, sumXY = 0.0, sumX2 = 0.0;
	for (int i = 0; i < num; i++) {
		double x = i;
		double y = pc[(double)start + i];
		sumX += x;
		sumY += y;
		sumXY += x * y;
		sumX2 += x * x;
	}

	double denominator = num * sumX2 - sumX * sumX;
	if (denominator == 0.0)
	{
		throw runtime_error("除零错误");
	}

	// 线性回归系数
	double slope = (num * sumXY - sumX * sumY) / denominator;
	double intercept = (sumY - slope * sumX) / num;

	// 当前bar对应的x
	double xVal = (double)num - 1;
	return intercept + slope * xVal;
}
