//| EXPMA 指数平均数                                                                                                |
//| close[0] = 最新数据，逆序                                                                                       |
//| num      = EXPMA 周期                                                                                           |
//+-----------------------------------------------------------------------------------------------------------------+
vector<double> test::EXPMA(vector<double> pc, int num)
{
	vector<double> result;

	if (num <= 0)
		return result;

	int size = pc.size();

	if (size < num)
		return result;

	// 鼎元数据为逆序，转换成正序
	reverse(pc.begin(), pc.end());

	result.resize(size, 0);

	// 初始 EXPMA 使用前 num 个收盘价的平均值
	double sum = 0;

	for (int i = 0; i < num; i++)
		sum += pc[i];

	result[num - 1] = sum / num;

	// EXPMA计算
	for (int i = num; i < size; i++)
	{
		result[i] =
			(close[i] * 2.0 + result[i - 1] * (num - 1.0)) / (num + 1.0);
	}
	// 转回鼎元逆序
	reverse(result.begin(), result.end());

	return result;
}
