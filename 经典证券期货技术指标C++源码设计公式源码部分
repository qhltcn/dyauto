double test::StandardDevFC(string period, string inst, int num)
{
	if (num <= 0)return 0;
	double value1 = 0;
	if (mapK[period][inst].size() < num) return 0;
	value1 = VarianceFC(period, inst, num);
	return sqrt(value1);
}
