	if (mapK[period][inst].empty())return 0;// 调用失败返回0
	map<string, TKVALUE>::reverse_iterator it;
	for (it = mapK[period][inst].rbegin(); it != mapK[period][inst].rend(); it++)
	{
		r++;
		if (r <= ref)continue;
		d = it->second.dLow;
		break;
	}
	return d;
}
// macd计算公式(数值版,返回最新MACD柱值)
// 算法与SeriesMACD(数组版)保持一致: diff=EMA(close,num1)-EMA(close,num2), dea=EMA(diff,num3), macd=(diff-dea)*2
double test::Macd(string period, string inst, int num1, int num2, int num3)
{
	if (num1 <= 0 || num2 <= 0 || num3 <= 0)return 0;
	vector<double> closeSeries = SeriesClose(); //取得该period/inst下的收盘价正序数组
	if (closeSeries.empty()) return 0;
	vector<double> ema1 = SeriesXaverage(closeSeries, num1); //短周期EMA,如12
	vector<double> ema2 = SeriesXaverage(closeSeries, num2); //长周期EMA,如26
	if (closeSeries.empty()) return 0;
	vector<double> diff = SeriesMinus(ema1, ema2);            //diff = ema1 - ema2
	vector<double> dea = SeriesXaverage(diff, num3);          //dea = ema(diff, num3),注意是对diff做平滑,不是对close
	if (diff.empty() || dea.empty()) return 0;
	return (diff.back() - dea.back()) * 2; //取最新一项,即macd柱值
}
//自适应移动平均线（Adaptive Exponential Moving Average,AEMA）返回数值模式
double test::Aema(string period, string inst, int num, int pds)//自适应移动平均线（Adaptive Exponential Moving Average, AEMA）
{
	if (length <= 0 || pds <= 0)return 0;

	RsqBar(period, inst);

	if ((int)mapK[period][inst].size() < pds)return 0;

	vector<double> High;
	vector<double> Low;
	vector<double> Close;

	map<string, TKVALUE>::iterator it;

	for (it = mapK[period][inst].begin();
		it != mapK[period][inst].end();
		++it)
	{
		High.push_back(it->second.dHigh);
		Low.push_back(it->second.dLow);
		Close.push_back(it->second.dClose);
	}

	double ema = Close[0];

	double alpha0 = 2.0 / (length + 1);

	for (int i = 1; i < (int)Close.size(); i++)
	{
		int start = i - pds + 1;

		if (start < 0)
			start = 0;

		double hh = High[start];
		double ll = Low[start];

		for (int j = start + 1; j <= i; j++)
		{
			if (High[j] > hh)
				hh = High[j];

			if (Low[j] < ll)
				ll = Low[j];
		}

		double adaptive = 0;

		if (hh != ll)
		{
			adaptive = fabs((Close[i] - ll) - (hh - Close[i])) / (hh - ll);
		}

		double alpha = (1.0 + adaptive) * alpha0;

		ema = ema + alpha * (Close[i] - ema);
	}

	return ema;
}
//返回PivotFC high数值(数值型)
double test::PivotHighFC(vector<double> pc, int leftbars, int rightbars, int currentIndex)
{
	if (pc.empty())return -1;
	if (currentIndex < 0)return -1;
	if (currentIndex >= (int)pc.size())return -1;
	if (leftbars <= 0 || rightbars <= 0)return -1;

	double CurrentPrice = pc[currentIndex];//定位比较基准

	// 边界检查(检查1)
	if (currentIndex < leftbars || (double)currentIndex + rightbars >= pc.size())
	{
		return -1;
	}
	//检查左侧条件		
	for (size_t i = 1; i <= leftbars; i++)
	{
		if (pc[currentIndex - i] >= CurrentPrice) //price[i]小于左侧N个值中的任意个则返回-1.即price[i]必须比左边leftgbars个数值都要大才行
		{
			return -1;
		}
	}
	//检查右侧条件
	for (int k = 1; k <= rightbars; k++)
	{
		if (pc[(double)currentIndex + k] >= CurrentPrice) //price[i]小于右侧N个值中的任意个则返回-1.即price[i]必须比右边rightbars个数值都要大才行
		{
			return -1;
		}
	}
	return CurrentPrice;//经过上面层层筛选仍然没有返回-1 说明是最高的那个bar,则返回这个bar的价格
}
