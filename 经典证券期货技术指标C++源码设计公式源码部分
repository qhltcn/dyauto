//---------------------------------------------------------------------------（版本二）-----------------------------------------------------------------+
vector<double> test::CalcSAR(int N, double STEP, double MAX)
{
	vector<double>highs, lows;
	highs = SeriesHigh();
	lows = SeriesLow();

	if (highs.size() != lows.size() || highs.size() < 2) {
		return {};
	}

	vector<double>sar(highs.size());

	bool isRising = highs[1] > highs[0];
	double ep = isRising ? highs[1] : lows[1];
	sar[0] = isRising ? lows[0] : highs[0];
	sar[1] = sar[0];
	double af = STEP;

	for (int i = 2; i < highs.size(); ++i) {
		sar[i] = sar[i - 1] + af * (ep - sar[i - 1]);

		if (isRising) {
			if (highs[i] > ep) {
				ep = highs[i];
				af = min2(af + STEP, MAX);
			}
			if (lows[i] < sar[i]) {
				isRising = false;
				sar[i] = ep;
				ep = lows[i];
				af = STEP;
			}
		}
		else {
			if (lows[i] < ep) {
				ep = lows[i];
				af = min2(af + STEP, MAX);
			}
			if (highs[i] > sar[i]) {
				isRising = true;
				sar[i] = ep;
				ep = highs[i];
				af = STEP;
			}
		}
	}
	reverse(sar.begin(), sar.end());//转为逆序，以与MC规范统一
	return sar;
}
