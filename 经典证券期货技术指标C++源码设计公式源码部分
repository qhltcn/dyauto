//严格遵守文华财经规则的SAR公式
/**
* 文华财经风格 SAR(N, STEP, MAX)
* @param high  最高价数组（正序：索引0=最早K线）
* @param low   最低价数组（正序：索引0=最早K线）
* @param N     初始周期，文华默认=4
* @param STEP  加速因子初始值，文华默认=0.02
* @param MAX   加速因子最大值，文华默认=0.20
*/
vector<double> test::Parabolic(int N, double STEP, double MAX)
{
	// === 内部结构体定义：封装计算结果 ===
	struct Result
	{
		vector<double> sar;   // 每根K线的SAR值
		vector<int> trend;    // 每根K线的趋势方向：1=多头，-1=空头，0=未定义
	};

	int n = 4;
	double step = 0.02;
	double max = 0.20;

	vector<double>highs, lows;
	highs = SeriesHigh();//最高价数据采集
	lows = SeriesLow();  //最低价数据采集

	int size1 = highs.size();
	vector<double>sar(size1, 0.0);//保存SAR值数组变量

	if (size1 < n + 2)
	{
		Print("数据长度不足，至少需要 N+2 根K线");
		return sar;
	}
	// === 1. 确定初始趋势 ===
	double upCount = 0, downCount = 0;
	for (int i = 1; i <= n; ++i) {
		if (highs[i] > highs[i - 1]) upCount++;
		if (lows[i] < lows[i - 1]) downCount++;
	}
	int trend = (upCount >= downCount) ? 1 : -1; // 1=多头, -1=空头

	// === 2. 初始化SAR、EP、AF ===
	double SAR = 0.0; // 当前SAR值
	double EP = 0.0;  // 极值点（Extreme Point）
	double AF = step; // 加速因子

	if (trend == 1) { // 初始多头
		SAR = *min_element(lows.begin(), lows.begin() + n);  // 最近N根最低价
		EP = *max_element(highs.begin(), highs.begin() + n); // 最近N根最高价
	}
	else {           // 初始空头
		SAR = *max_element(highs.begin(), highs.begin() + n); // 最近N根最高价
		EP = *min_element(lows.begin(), lows.begin() + n);    // 最近N根最低价
	}

	sar[n - 1] = SAR;

	// === 3. 从第N根开始递推计算 ===
	for (int i = n; i < size1; ++i)
	{
		// 3.1 计算SAR
		SAR = SAR + AF * (EP - SAR);

		// 3.2 修正SAR越界
		if (trend == 1) { // 多头
			SAR = min2(SAR, lows[i - 1]);
			SAR = min2(SAR, lows[i - 2]);
		}
		else {          // 空头
			SAR = max2(SAR, highs[i - 1]);
			SAR = max2(SAR, highs[i - 2]);
		}

		// 3.3 判断趋势翻转
		bool reverse = false;
		if (trend == 1 && lows[i] < SAR) {
			// 多头 → 空头
			trend = -1;
			reverse = true;
			SAR = EP;      // 翻转时SAR重置为之前的EP
			EP = lows[i];   // 新趋势EP = 当前最低价
			AF = step;     // AF重置
		}
		else if (trend == -1 && highs[i] > SAR) {
			// 空头 → 多头
			trend = 1;
			reverse = true;
			SAR = EP;
			EP = highs[i];
			AF = step;
		}

		// 3.4 如果未翻转，更新EP和AF
		if (!reverse) {
			if (trend == 1) {
				if (highs[i] > EP) {
					EP = highs[i];
					AF = min2(AF + step, max);
				}
			}
			else {
				if (lows[i] < EP) {
					EP = lows[i];
					AF = min2(AF + step, max);
				}
			}
		}

		// 保存计算结果
		sar[i] = SAR;
	}
	reverse(sar.begin(), sar.end());//调转数组顺序以与行业规范统一
	return sar;
}
// OBV指标：能量潮,内部用正序数组计算(SeriesClose/SeriesVolume)，最终返回逆序数组([0]为最新)
vector<double>test::OBV()
{
	vector<double> closePrice = SeriesClose();    // 正序，[0]最老
	vector<double> vol = SeriesVolume();          // 正序，[0]最老
	// 数据检查
	if (closePrice.size() != vol.size()) { Print("  收盘价与成交量数据没有对齐！"); return vector<double>(); }

	vector<double> obvSeries(closePrice.size(), 0.0); // 正序中间结果

	for (size_t i = 1; i < closePrice.size(); i++)
	{
		double diff = closePrice[i] - closePrice[(double)i - 1];

		if (diff > 0)
			obvSeries[i] = obvSeries[i - 1] + vol[i];
		else if (diff < 0)
			obvSeries[i] = obvSeries[i - 1] - vol[i];
		else
			obvSeries[i] = obvSeries[i - 1];
	}
	// 转换为逆序输出，[0]为最新值，与你其他接口保持一致
	vector<double>obv(obvSeries.rbegin(), obvSeries.rend());
	return obv;
}
// 三重指数平滑振荡器（TRIX: Triple Exponential Smoothing Oscillator)
//====================================================== 
// 三重指数平滑振荡器 
// TRIX: Triple Exponential Smoothing Oscillator // 
// TRIX = (EMA3 - REF(EMA3,1)) / REF(EMA3,1) * 100 // 
// 输入： 
// pc = 价格序列，鼎元默认 [0] 为最新 
// num = EMA周期
// 输出： 
// 返回TRIX序列，保持鼎元顺序：[0]为最新 
//======================================================
vector<double> test::TRIX(vector<double>pc, int num)
{
	vector<double> result;
	// 数据检查
	if (pc.size() < MaxBarsBack) { Print("  数据数量少于最少保留数量！"); return  result; }
	if (num <= 1) { Print("  周期参数非法！"); return  result; }
	// 将鼎元的时间倒序转换为正常时间顺序,转换后：[0]最早，[a-1]最新
	reverse(pc.begin(), pc.end());
	int a = pc.size();               // 获得pc数组的长度
	vector<double>ema1, ema2, ema3;
	ema1 = SeriesXaverage(pc, num);
	ema2 = SeriesXaverage(ema1, num);
	ema3 = SeriesXaverage(ema2, num);
	vector<double>trix(a, 0);
	for (size_t i = 1; i < a; i++)
	{
		if (ema3[i - 1] != 0)
		{
			trix[i] = (ema3[i] - ema3[i - 1]) / ema3[i - 1] * 100.0;
		}
		else
		{
			trix[i] = 0;
		}

	}
	// 第一根没有前值 
	trix[0] = 0;
	//================================================== 
	// 恢复鼎元顺序 
	// [0] = 最新 
	//================================================== 
	reverse(trix.begin(), trix.end());
	return trix;
}
