//返回均方根(Root Mean Square,RMS)(逆序数组)
vector<double> test::RMS(vector<double> pc, int num)
{
	reverse(pc.begin(), pc.end());
	vector<double> newrms;
	if (num <= 0)return newrms;
	for (size_t i = 0; i < pc.size(); i++)
	{
		if ((int)i + 1 < num)
		{
			newrms.push_back(pc[i]);
		}
		else
		{
			double sum = 0;

			for (int j = 0; j < num; j++)
				sum += pc[i - j] * pc[i - j];
			newrms.push_back(sqrt(sum / num));
		}
	}
	reverse(newrms.begin(), newrms.end());
	return newrms;
}
//返回均方根(Root Mean Square,RMS)(逆序数组)
vector<double> test::SuperSmoother(vector<double> pc, int num)
{
	reverse(pc.begin(), pc.end());//恢复计算变量为正序以方便下面的计算
	double a1, b1, c1, c2, c3;
	vector<double>newsupers;
	a1 = exp(-1.414 * 3.15159 / num);
	b1 = 2 * a1 * cos(1.414 * 180 / num);
	c2 = b1;
	c3 = -a1 * a1;
	c1 = 1 - c2 - c3;
	for (size_t i = 0; i < pc.size(); i++)
	{
		if (i < 2)
		{
			newsupers.push_back((double)0);//当pc数据元素少于num时，newsupers元素用0价格代替
		}
		else
		{
			double d = c1 * (pc[i] + pc[i - 1]) / 2 + c2 * newsupers[i - 1] + c3 * newsupers[i - 2];//supersmoother计算公式
			newsupers.push_back(d);
		}
	}
	reverse(newsupers.begin(), newsupers.end());//调转数组为逆序
	return newsupers;
}
//返回Highpass(逆序数组)
vector<double> test::Highpass(vector<double> pc, int num)
{
	reverse(pc.begin(), pc.end());//恢复计算变量为正序以方便下面的计算
	double a1, b1, c1, c2, c3;
	vector<double>newhipass;
	a1 = exp(-1.414 * 3.15159 / num);
	b1 = 2 * a1 * cos(1.414 * 180 / num);
	c2 = b1;
	c3 = -a1 * a1;
	c1 = (1 + c2 - c3) / 4;
	for (size_t i = 0; i < pc.size(); i++)
	{
		if (i < 2)
		{
			newhipass.push_back((double)0);//当pc数据元素少于num时，newsupers元素用0价格代替
		}
		else
		{
			double d = c1 * (pc[i] - 2 * pc[i - 1] + pc[i - 2]) + c2 * newhipass[i - 1] + c3 * newhipass[i - 2];//newhipass计算公式
			newhipass.push_back(d);
		}
	}
	reverse(newhipass.begin(), newhipass.end());//调转数组为逆序
	return newhipass;

}
