//|                                                                                                                 |
//| cond[i] != 0  -> 返回 a[i]                                                                                     |
//| cond[i] == 0  -> 返回 b[i]                                                                                     |
//|                                                                                                                 |
//| 对应公式：IF(条件,A,B)                                                                                           |
//+-----------------------------------------------------------------------------------------------------------------+
vector<double> test::SeriesIff(vector<double> cond, vector<double> a, vector<double> b)
{
	vector<double> result;

	int n = cond.size();

	if (a.size() < n)
		n = a.size();

	if (b.size() < n)
		n = b.size();

	result.resize(n);

	for (int i = 0; i < n; i++)
	{
		if (cond[i] != 0)
			result[i] = a[i];
		else
			result[i] = b[i];
	}

	return result;
}
