//返回SwingHigh数值(逆序数组)将SwingHigh不为零的值存入数组，并调转为逆序，方便引用
vector<double> test::SwingHigh(vector<double> pc, int leftbars, int rightbars)
{
	reverse(pc.begin(), pc.end());//恢复计算变量为正序以方便下面的计算
	vector<double>newswinghigh;//声明一个变量存储swinghigh
	newswinghigh.clear();

	for (size_t i = leftbars; i + rightbars < pc.size(); i++)//设计SwingHigh
	{
		double CurrentPrice = pc[i];//定义比较基准
		// 边界检查
		if (i < leftbars || i + rightbars >= pc.size())
		{
			CurrentPrice = -1;//SwingHigh值用-1代替
		}
		//检查左侧条件		
		for (size_t j = 1; j <= leftbars; j++)
		{
			if (pc[i - j] >= CurrentPrice) //price[i]小于左侧N个值中的任意个则返回-1.即price[i]必须比左边leftgbars个数值都要大才行
			{
				CurrentPrice = -1;
			}
		}
		//检查右侧条件
		for (int k = 1; k <= rightbars; k++)
		{
			if (pc[i + k] >= CurrentPrice) //price[i]小于右侧N个值中的任意个则返回-1.即price[i]必须比右边rightbars个数值都要大才行
			{
				CurrentPrice = -1;
			}
		}
		if (CurrentPrice != -1)newswinghigh.push_back(CurrentPrice);
	}
	reverse(newswinghigh.begin(), newswinghigh.end());//调转数组为逆序
	return newswinghigh;//返回swinghigh数组形式非-1值数值,最新值序列标号为[0]
}
